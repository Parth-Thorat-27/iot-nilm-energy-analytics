     },
     "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"node_status\" and r._field == \"online\" and r.room == \"${room}\")\n  |> group()\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
