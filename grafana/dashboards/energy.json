   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-iota"
     },
     "query": "from(bucket: v.defaultBucket)\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"appliance_state\" and r.room == \"${room}\")\n  |> last()\n  |> pivot(rowKey: [\"_time\", \"appliance\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"appliance\", \"power_w\", \"since_min\"])\n  |> sort(columns: [\"power_w\"], desc: true)"
    }
   ],
   "options": {
