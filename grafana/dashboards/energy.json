{
 "uid": "iota-energy",
 "title": "NILM Energy Analytics",
 "tags": [
  "nilm",
  "energy"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 2,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "room",
    "label": "Room",
    "type": "query",
    "datasource": {
     "type": "influxdb",
     "uid": "influxdb-iota"
    },
    "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"room\", predicate: (r) => r._measurement == \"power\", start: -30d)",
    "refresh": 2,
    "includeAll": false,
    "multi": false
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Current (RMS)",
   "datasource": {
    "type": "influxdb",
    "uid": "influxdb-iota"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "amp",
     "decimals": 2,
     "color": {
      "mode": "thresholds",
      "fixedColor": "blue"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 5
       },
       {
        "color": "red",
        "value": 8
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-iota"
     },
     "query": "from(bucket: v.defaultBucket)\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"power\" and r._field == \"current_a\" and r.room == \"${room}\")\n  |> group()\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Apparent power",
   "datasource": {
    "type": "influxdb",
    "uid": "influxdb-iota"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "voltamp",
     "decimals": 0,
     "color": {
      "mode": "thresholds",
      "fixedColor": "blue"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1150
       },
       {
        "color": "red",
        "value": 1840
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-iota"
     },
     "query": "from(bucket: v.defaultBucket)\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"power\" and r._field == \"apparent_va\" and r.room == \"${room}\")\n  |> group()\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Energy today",
   "datasource": {
    "type": "influxdb",
    "uid": "influxdb-iota"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "kwatth",
     "decimals": 2,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-iota"
     },
     "query": "import \"date\"\nimport \"timezone\"\noption location = timezone.location(name: \"Asia/Kolkata\")\nfrom(bucket: v.defaultBucket)\n  |> range(start: date.truncate(t: now(), unit: 1d))\n  |> filter(fn: (r) => r._measurement == \"power\" and r._field == \"apparent_va\" and r.room == \"${room}\")\n  |> group()\n  |> integral(unit: 1h)\n  |> map(fn: (r) => ({ r with _value: r._value / 1000.0 }))"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Standby baseline",
   "datasource": {
    "type": "influxdb",
    "uid": "influxdb-iota"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "watt",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "purple"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-iota"
     },
     "query": "from(bucket: v.defaultBucket)\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"appliance_power\" and r.appliance == \"baseline\" and r.room == \"${room}\")\n  |> group()\n  |> last()"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Efficiency factor (24 h)",
   "datasource": {
    "type": "influxdb",
    "uid": "influxdb-iota"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 0,
     "color": {
      "mode": "thresholds",
      "fixedColor": "blue"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "green",
        "value": 85
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-iota"
     },
     "query": "from(bucket: v.defaultBucket)\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"nilm_summary\" and r._field == \"efficiency_pct\" and r.room == \"${room}\")\n  |> group()\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "description": "Share of energy that went to active (switched) loads rather than the always-on standby baseline."
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Edge node",
   "datasource": {
