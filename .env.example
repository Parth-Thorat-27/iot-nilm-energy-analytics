# ---- Copy to .env and fill in ----
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change-me-min-8-chars
INFLUXDB_ORG=iota
INFLUXDB_BUCKET=energy
INFLUXDB_TOKEN=generate-a-long-random-token
INFLUXDB_RETENTION=90d

GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# Used by the Python services (running on this PC)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=+/+/power
INFLUXDB_URL=http://localhost:8086

# Local timezone for night/unoccupied rules
TZ_NAME=Asia/Kolkata
# Optional: Slack/Discord webhook or https://ntfy.sh/<your-topic> for wastage alerts
ALERT_WEBHOOK_URL=
